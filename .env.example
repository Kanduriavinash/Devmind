# Optional OpenAI-compatible chat completion endpoint. Leave unset for offline analysis.
DEVMIND_LLM_BASE_URL=
DEVMIND_LLM_API_KEY=
DEVMIND_LLM_MODEL=

# Python sandbox image (built from docker/sandbox/Dockerfile).
DEVMIND_DOCKER_IMAGE=devmind-sandbox:py312

# Select one runner for this app process. Use `node` for JavaScript/HTML fixtures.
DEVMIND_TEST_RUNNER=pytest
DEVMIND_NODE_DOCKER_IMAGE=devmind-sandbox:node22

# Sandbox timeout in seconds.
DEVMIND_SANDBOX_TIMEOUT_SECONDS=120

